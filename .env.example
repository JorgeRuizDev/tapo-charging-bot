# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Security: Comma-separated list of Telegram User IDs permitted to use the bot
# You can find your user ID by sending a message to @userinfobot or @rawdatabot
TELEGRAM_ALLOWED_USER_IDS=123456789

# Tapo Smart Plug Configuration
# IP address assigned to your Tapo plug (e.g. Tapo P110 / P115) in your local router
TAPO_IP=192.168.1.100
# Your TP-Link Tapo cloud account email and password
TAPO_USERNAME=your_tapo_email@example.com
TAPO_PASSWORD=your_tapo_password

# Set to true to test/run without physical hardware using a mock plug simulator
TAPO_MOCK=false

# Charging & Vehicle Preferences
# Usable battery capacity of vehicle/device in kWh (e.g., 11.8 for PHEV, 50-77 for EV)
DEFAULT_BATTERY_CAPACITY_KWH=11.8

# Charging efficiency (ratio of battery energy added to wall energy drawn: e.g. 0.85 = 85%)
CHARGING_EFFICIENCY=0.85

# Rolling lookback window for energy statistics in hours (default: 18 hours)
DEFAULT_ROLLING_WINDOW_HOURS=18.0

# Minimum power draw (in Watts) to consider charging active (e.g. 15.0W)
CHARGING_IDLE_THRESHOLD_WATTS=15.0

# Debounce period in seconds before concluding that a vehicle has finished charging
CHARGING_DEBOUNCE_SECONDS=45

# Whether to automatically switch off the plug when a natural full charge is reached
# (Defaults to false: plug stays ON, only turns OFF if a specific target was requested)
AUTO_OFF_ON_FULL=false

# Electricity cost rate in €/kWh (used for session cost estimates)
ELECTRICITY_COST_PER_KWH=0.15

# Polling interval in seconds to read power/energy from the plug
POLLING_INTERVAL_SECONDS=10

# Database file path
DATABASE_PATH=tapo_charging.db
